# Environment variables for deterministic-neural-video-codec
# Copy this file to .env only if you need env-var based overrides.

# Optional explicit config path (if not using ./config.yaml)
# DCVC_CONFIG=config.yaml

# Optional model bundle URL override for scripts/download_models.py
# DCVC_BUNDLE_URL=https://github.com/<owner>/<repo>/releases/download/v1.0.0/int16_bundle_v1.0.0.pt
